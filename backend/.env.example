# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# YouTube Data API v3 (https://console.cloud.google.com/apis/credentials) - optional,
# powers video suggestions in the AI Tutor chat. Leave blank to disable.
YOUTUBE_API_KEY=

# MongoDB - stores user accounts
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=nova

# Google OAuth (https://console.cloud.google.com/apis/credentials) - "OAuth client ID",
# type "Web application". Add http://localhost:5173 as an authorized JavaScript origin.
# This is the public Client ID (ends in .apps.googleusercontent.com), not a secret.
GOOGLE_CLIENT_ID=

# SMTP - sends "forgot password" reset emails. Works with any SMTP provider you already
# have (e.g. Gmail with an app password, an existing transactional-mail account). Leave
# blank to disable sending; reset links will just be logged to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Cadence <no-reply@example.com>
